# Secret credential from Developer Portal > Bot. Never share or commit it.
DISCORD_TOKEN=your-bot-token

# Public Application ID from Developer Portal > General Information.
DISCORD_CLIENT_ID=your-application-id

# Server ID used only by `pnpm deploy:test` for rapid testing.
# Global production deployment does not use this value.
DISCORD_TEST_GUILD_ID=your-test-server-id

# Optional. Enables the Fish Audio voices in /preset-tts; the Edge voices work
# without it. Get one from https://fish.audio account settings.
FISH_API_KEY=

# Optional. Overrides the Fish model. Defaults to s2.1-pro-free.
FISH_MODEL=
